---
/** 极简线性图标，只有描边，跟着字色走 */
interface Props {
  name:
    | 'bell'
    | 'pin'
    | 'mail'
    | 'link'
    | 'github'
    | 'clock'
    | 'users'
    | 'pen'
    | 'pencil'
    | 'building'
    | 'star'
    | 'commit'
    | 'branch'
    | 'issue'
    | 'book'
    | 'flame';
  size?: number;
}
const { name, size = 15 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'bell' && (
    <>
      <path d="M12 3a6 6 0 0 1 6 6v5l2 3.2H4L6 14V9a6 6 0 0 1 6-6Z" />
      <path d="M10 20.5a2 2 0 0 0 4 0" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10Z" />
      <circle cx="12" cy="11" r="2.2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 7 8.5 6 8.5-6" />
    </>
  )}
  {name === 'link' && (
    <>
      <path d="M10 13.5a4 4 0 0 0 5.7 0l2.3-2.3a4 4 0 1 0-5.7-5.7L11 6.8" />
      <path d="M14 10.5a4 4 0 0 0-5.7 0L6 12.8a4 4 0 1 0 5.7 5.7l1.3-1.3" />
    </>
  )}
  {name === 'github' && (
    <path d="M9 19.5c-4 1.2-4-2-5.5-2.5m11 5.5v-3.4c0-1 .1-1.4-.5-2 2.3-.3 4.5-1.2 4.5-5a4 4 0 0 0-1.1-2.8 3.7 3.7 0 0 0-.1-2.8s-.9-.3-3 1.1a10.3 10.3 0 0 0-5.4 0C6.8 6.2 5.9 6.5 5.9 6.5a3.7 3.7 0 0 0-.1 2.8A4 4 0 0 0 4.7 12c0 3.8 2.2 4.7 4.5 5-.6.6-.6 1.2-.5 2v3.4" />
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8.5" r="3.2" />
      <path d="M3.5 19.5a5.5 5.5 0 0 1 11 0" />
      <path d="M16 5.6a3.2 3.2 0 0 1 0 6.3m4.5 7.6a5.5 5.5 0 0 0-4-5" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <path d="M4.6 19.4 5.7 15 16.4 4.3a2.1 2.1 0 0 1 3 3L8.7 18.6l-4.1.8Z" />
      <path d="m14.7 6 3.3 3.3" />
    </>
  )}
  {name === 'pen' && (
    <>
      <path d="M4 20h16" />
      <path d="M15.5 4.6 6 14v3.5h3.5L19 8.1 15.5 4.6Z" />
    </>
  )}
  {name === 'building' && (
    <>
      <path d="M4.5 20.5V5.7a2.2 2.2 0 0 1 2.2-2.2h6.1a2.2 2.2 0 0 1 2.2 2.2v14.8" />
      <path d="M15 10.5h2.8a2.2 2.2 0 0 1 2.2 2.2v7.8" />
      <path d="M3.2 20.5h17.6" />
      <path d="M7.7 7h2.6M7.7 10.6h2.6M7.7 14.2h2.6M7.7 17.6h2.6" />
    </>
  )}
  {name === 'star' && (
    <path d="M12 4.2l2.5 5 5.5.8-4 3.9.95 5.5L12 16.8 7.05 19.4 8 13.9l-4-3.9 5.5-.8L12 4.2Z" />
  )}
  {name === 'commit' && (
    <>
      <circle cx="12" cy="12" r="3.2" />
      <path d="M2.8 12h6M15.2 12h6" />
    </>
  )}
  {name === 'branch' && (
    <>
      <circle cx="7" cy="6" r="2.2" />
      <circle cx="7" cy="18" r="2.2" />
      <path d="M7 8.2v7.6" />
      <circle cx="17" cy="6" r="2.2" />
      <path d="M17 8.2v3.1a4.6 4.6 0 0 1-4.6 4.6H9.2" />
    </>
  )}
  {name === 'issue' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M12 7.4C10.7 6 8.9 5.4 6.3 5.4H4.4v12.3h1.9c2.5 0 4.3.6 5.7 1.9 1.4-1.3 3.2-1.9 5.7-1.9h1.9V5.4h-1.9c-2.6 0-4.4.6-5.7 2Z" />
      <path d="M12 7.4v12.2" />
    </>
  )}
  {name === 'flame' && (
    <path d="M12 3.5c1.9 2.4 5.5 5.1 5.5 8.9a5.5 5.5 0 0 1-11 0c0-2.4 1.5-3.9 2.7-5.3.2 1.1.7 1.8 1.4 2.2-.4-2.1.4-4.2 1.4-5.8Z" />
  )}
</svg>