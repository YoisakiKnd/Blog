---
import Icon from './Icon.astro';
import type { Post } from '../lib/posts';
import { countCategories, countTags } from '../lib/posts';
import { site } from '../site.config';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const categories = countCategories(posts);
const tags = countTags(posts);
---

<aside class="side">
  <!-- 站点卡 -->
  <div class="card site">
    <h3 class="card-title cname">{site.name}</h3>
    <p class="cdesc">{site.aside}</p>
    <a class="btn btn--solid gh" href={site.github}>
      <Icon name="github" size={15} />
      GitHub
    </a>
  </div>

  <!-- 分类 -->
  <div class="card">
    <h3 class="card-title">分类</h3>
    {categories.length === 0 ? (
      <p class="empty">还没有分类。</p>
    ) : (
      <ul class="tax">
        {categories.map((c) => (
          <li>
            <span class="tname">{c.name}</span>
            <span class="n">{c.count}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- 标签 -->
  <div class="card">
    <h3 class="card-title">标签</h3>
    {tags.length === 0 ? (
      <p class="empty">还没有标签。</p>
    ) : (
      <ul class="chips taglist">
        {tags.map((t) => (
          <li class="chip">
            {t.name}
            <span class="n">{t.count}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</aside>

<style>
  /* 侧栏跟着滚动一直可见：钉在标题条正下方（--topbar + --headh + 网格的上边距）。
     它六百多像素高，窗口太矮时靠 max-height 让它在自己内部滚，保证始终完整可见；
     单列布局（窄屏）下左栏本来就在正文前面，不再吸顶。 */
  .side {
    align-self: start;
    font-size: 14px;
    position: sticky;
    top: calc(var(--topbar) + var(--headh) + 14px);
    max-height: calc(100vh - var(--topbar) - var(--headh) - 28px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  @media (max-width: 900px) {
    .side {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  .site {
    text-align: center;
  }
  .card-title.cname {
    font-size: 17px;
    letter-spacing: 0.08em;
  }
  .cdesc {
    margin: 8px 0 14px;
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .gh {
    width: 100%;
  }

  .tax {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tax li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid #e8e8e8;
  }
  .tax li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .tname {
    color: var(--ink);
  }
  .n {
    font-size: 12.5px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .taglist {
    margin: 0;
  }

  .empty {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-3);
  }

</style>