---
import type { Post } from '../lib/posts';
import { countCategories, countTags } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const categories = countCategories(posts);
const tags = countTags(posts);
---

<aside class="side">
  <!-- 分类 -->
  <div class="card">
    <h3 class="card-title"><a href="/categories/">分类</a></h3>
    {categories.length === 0 ? (
      <p class="empty">还没有分类。</p>
    ) : (
      <ul class="tax">
        {categories.map((c) => (
          <li>
            <a class="tax-row" href={`/categories/${c.name}/`}>
              <span class="tname">{c.name}</span>
              <span class="n">{c.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- 标签 -->
  <div class="card">
    <h3 class="card-title"><a href="/tags/">标签</a></h3>
    {tags.length === 0 ? (
      <p class="empty">还没有标签。</p>
    ) : (
      <ul class="chips">
        {tags.map((t) => (
          <li>
            <a class="chip" href={`/tags/${t.name}/`}>
              {t.name}
              <span class="n">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</aside>

<style>
  /* 左栏跟着滚动一直可见：钉在标题条正下方（--topbar + --headh + 网格的上边距）。
     窗口太矮时靠 max-height 让它在自己内部滚，保证始终完整可见；
     单列布局（窄屏）下左栏本来就在正文前面，不再吸顶。 */
  .side {
    align-self: start;
    font-size: 14px;
    position: sticky;
    top: calc(var(--topbar) + var(--headh) + 14px);
    max-height: calc(100vh - var(--topbar) - var(--headh) - 28px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  @media (max-width: 900px) {
    .side {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  .empty {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-3);
  }
</style>
