{
  "name": "post-cms",
  "displayName": "笔记 CMS",
  "description": "在侧边栏里管笔记和数据页：点一下就能改，不用翻配置文件",
  "version": "0.3.0",
  "publisher": "tyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoisakiKnd/Blog.git",
    "directory": "tools/post-cms"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:postCms.posts",
    "onCommand:postCms.newPost",
    "onCommand:postCms.refresh",
    "onCommand:postCms.startDev"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "postCms",
          "title": "笔记 CMS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "postCms": [
        {
          "id": "postCms.posts",
          "name": "笔记",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "postCms.pages",
          "name": "页面数据"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "postCms.posts",
        "contents": "还没有笔记。\n[新建一篇](command:postCms.newPost)"
      }
    ],
    "commands": [
      {
        "command": "postCms.newPost",
        "title": "新建文章",
        "category": "笔记",
        "icon": "$(add)"
      },
      {
        "command": "postCms.refresh",
        "title": "刷新列表",
        "category": "笔记",
        "icon": "$(refresh)"
      },
      {
        "command": "postCms.startDev",
        "title": "启动本地预览（pnpm dev）",
        "category": "笔记",
        "icon": "$(play)"
      },
      {
        "command": "postCms.openPost",
        "title": "打开文章",
        "category": "笔记"
      },
      {
        "command": "postCms.openPreview",
        "title": "在浏览器里打开",
        "category": "笔记",
        "icon": "$(globe)"
      },
      {
        "command": "postCms.toggleDraft",
        "title": "发布 / 转回草稿",
        "category": "笔记",
        "icon": "$(check)"
      },
      {
        "command": "postCms.editPost",
        "title": "改这篇的内容",
        "category": "笔记",
        "icon": "$(edit)"
      },
      {
        "command": "postCms.setCategory",
        "title": "改分类",
        "category": "笔记"
      },
      {
        "command": "postCms.setTags",
        "title": "改标签",
        "category": "笔记"
      },
      {
        "command": "postCms.setSeries",
        "title": "改系列",
        "category": "笔记"
      },
      {
        "command": "postCms.setDate",
        "title": "改发布日期",
        "category": "笔记"
      },
      {
        "command": "postCms.deletePost",
        "title": "删除文章",
        "category": "笔记",
        "icon": "$(trash)"
      },
      {
        "command": "postCms.refreshPages",
        "title": "刷新页面数据",
        "category": "笔记"
      },
      {
        "command": "postCms.openDataPage",
        "title": "在浏览器里打开这个页面",
        "category": "笔记"
      },
      {
        "command": "postCms.revealData",
        "title": "在 site.config.ts 里定位",
        "category": "笔记"
      },
      {
        "command": "postCms.addData",
        "title": "加一项",
        "category": "笔记"
      },
      {
        "command": "postCms.editData",
        "title": "改内容",
        "category": "笔记",
        "icon": "$(edit)"
      },
      {
        "command": "postCms.removeData",
        "title": "删掉这一项",
        "category": "笔记",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "postCms.refresh",
          "when": "view == postCms.posts",
          "group": "navigation@1"
        },
        {
          "command": "postCms.startDev",
          "when": "view == postCms.posts",
          "group": "navigation@2"
        },
        {
          "command": "postCms.refreshPages",
          "when": "view == postCms.pages",
          "group": "navigation@1"
        },
        {
          "command": "postCms.startDev",
          "when": "view == postCms.pages",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "postCms.openPreview",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "inline@1"
        },
        {
          "command": "postCms.toggleDraft",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "inline@2"
        },
        {
          "command": "postCms.deletePost",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "inline@3"
        },
        {
          "command": "postCms.editPost",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "1_edit@0"
        },
        {
          "command": "postCms.setCategory",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "1_edit@1"
        },
        {
          "command": "postCms.setTags",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "1_edit@2"
        },
        {
          "command": "postCms.setSeries",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "1_edit@3"
        },
        {
          "command": "postCms.setDate",
          "when": "viewItem =~ /postCms\\.(draft|published)/",
          "group": "1_edit@4"
        },
        {
          "command": "postCms.openDataPage",
          "when": "view == postCms.pages && viewItem == postCms.page",
          "group": "inline@1"
        },
        {
          "command": "postCms.revealData",
          "when": "view == postCms.pages",
          "group": "8_locate@1"
        },
        {
          "command": "postCms.addData",
          "when": "view == postCms.pages && (viewItem == postCms.page || viewItem == postCms.entry || viewItem == postCms.doing)",
          "group": "inline@2"
        },
        {
          "command": "postCms.editData",
          "when": "view == postCms.pages && viewItem != postCms.page",
          "group": "inline@3"
        },
        {
          "command": "postCms.editData",
          "when": "view == postCms.pages && viewItem != postCms.page",
          "group": "1_edit@1"
        },
        {
          "command": "postCms.removeData",
          "when": "view == postCms.pages && (viewItem == postCms.entry || viewItem == postCms.item || viewItem == postCms.doingItem)",
          "group": "2_remove@1"
        }
      ]
    },
    "configuration": {
      "title": "笔记 CMS",
      "properties": {
        "postCms.postsDir": {
          "type": "string",
          "default": "src/content/posts",
          "description": "笔记目录，相对仓库根目录"
        },
        "postCms.siteUrl": {
          "type": "string",
          "default": "http://localhost:4321",
          "description": "本地预览地址，用来拼 /posts/<文件名>/"
        },
        "postCms.devCommand": {
          "type": "string",
          "default": "pnpm dev",
          "description": "「启动本地预览」在终端里跑的命令"
        },
        "postCms.defaultCategory": {
          "type": "string",
          "default": "日常",
          "description": "新建文章时的默认分类"
        },
        "postCms.configFile": {
          "type": "string",
          "default": "src/site.config.ts",
          "description": "数据页（项目/友链/装备/书架/现在）所在的配置文件，相对仓库根"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node --test",
    "package": "node esbuild.mjs && vsce package --no-dependencies -o post-cms.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
